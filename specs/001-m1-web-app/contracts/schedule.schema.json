{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stay-sharp.lumineth.com/schema/schedule.v1.json",
  "title": "Daily schedule file (private content repository): one entry per date and level",
  "type": "object",
  "additionalProperties": false,
  "required": ["level", "days"],
  "properties": {
    "level": { "enum": ["senior", "starter", "selftest"] },
    "targets": {
      "type": "object",
      "description": "Target seconds per deck; copied into each daily set at publish.",
      "additionalProperties": { "type": "integer", "minimum": 5, "maximum": 300 }
    },
    "days": {
      "type": "object",
      "propertyNames": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "additionalProperties": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string" } }
    }
  }
}
